{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spider",
  "version": "0.1.0",
  "identifier": "dev.smid.spider",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spider",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
